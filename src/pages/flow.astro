---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/seo/Breadcrumb.astro";
import CTABanner from "../components/sections/CTABanner.astro";
import { COMPANY } from "../data/company";
---

<BaseLayout
  title="ご利用の流れ"
  description={`${COMPANY.name}のご利用の流れ。料金を作業の前に確定し、ご承諾をいただいてからお伺いします。お問い合わせから作業完了までを5つのステップでご説明します。`}
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <Breadcrumb items={[{ name: "ご利用の流れ", href: "/flow/" }]} />

    <h1 class="text-3xl md:text-4xl font-bold text-brand-dark mb-4">ご利用の流れ</h1>
    <p class="text-gray-600 mb-12">
      料金は作業の前に確定し、ご承諾をいただいてからお伺いします。<br />
      ご不明な点はいつでもお気軽にお問い合わせください。
    </p>

    <div class="space-y-8">
      {
        [
          {
            step: "01",
            title: "お問い合わせ",
            desc: "電話・メール・LINEでお気軽にご連絡ください。回収するお品物や作業の内容、ご希望の日時・場所をお伺いします。",
            tips: ["電話：8:00〜20:00（年中無休）", "メール：24時間受付", "返信は通常当日〜翌営業日"],
          },
          {
            step: "02",
            title: "お見積もり・料金の確定",
            desc: "お写真やお電話で内容を確認し、回収内容・作業内容・税込総額・訪問日・お支払い方法をLINE等でご提示します。お見積もりは無料です。",
            tips: ["お見積もり費用は0円", "税込総額でご提示します", "現地でのお見積もりもご相談ください"],
          },
          {
            step: "03",
            title: "ご依頼の確定",
            desc: "ご提示した内容にご承諾いただいた時点で、ご依頼の確定です。内容の追加・変更をご希望の場合は、改めてお見積もりをご提示し、ご承諾をいただいてから承ります。",
            tips: ["ご承諾前のキャンセルは無料", "追加・変更は事前に再提示", "断っても費用は発生しません"],
          },
          {
            step: "04",
            title: "作業実施",
            desc: "お約束の日時にスタッフが伺い、確定した内容のとおりに作業します。搬出・後片付けまで一括で対応します。お客様はお立ち会いいただくだけです。",
            tips: ["ご不在対応も可（要事前相談）", "作業中の状況はご説明します", "後片付け・養生も丁寧に"],
          },
          {
            step: "05",
            title: "お支払い・完了",
            desc: "作業完了後に仕上がりをご確認いただき、お支払いです。現金・クレジットカード・PayPay・銀行振込に対応しています。クレジットカードは、料金の確定後から作業完了までの間にお支払いいただけます。",
            tips: ["現金/カード/PayPay/振込対応", "領収書発行可", "アフターフォローも安心"],
          },
        ].map((item) => (
          <div class="flex gap-6">
            <div class="flex flex-col items-center">
              <div class="w-12 h-12 rounded-full bg-brand-primary text-white font-black text-lg flex items-center justify-center shrink-0">
                {item.step}
              </div>
              <div class="w-0.5 bg-gray-200 flex-1 mt-2" />
            </div>
            <div class="pb-8 flex-1">
              <h2 class="text-xl font-bold text-brand-dark mb-3">{item.title}</h2>
              <p class="text-gray-700 leading-relaxed mb-4">{item.desc}</p>
              <ul class="space-y-1">
                {item.tips.map((tip) => (
                  <li class="flex items-center gap-2 text-sm text-gray-600">
                    <span class="text-brand-accent">✓</span>
                    {tip}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>

  </div>
</BaseLayout>

<CTABanner />
